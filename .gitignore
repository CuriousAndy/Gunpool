# Dependencies
node_modules/

# Compilation output
/dist

# pnpm deploy output
/bundle

# Hardhat build artifacts / cache
/artifacts
/cache

# Typechain output
/types

# Hardhat coverage reports
/coverage

# Local runtime state (Ganache chain DB, SQLite files, ...) at any depth
.local/

# Per-machine deployment addresses, generated by `npm run dev:local` / `deploy:local:once`.
# Do NOT commit: a committed file makes `dev:local` on a fresh clone abort, because it finds
# a deployment file but no matching contracts on the (empty) local chain.
deployments.local.json
/deployments/

# Secrets / env
.env
.env.*
!.env.example
*.pem

# Logs and editor/tool leftovers
*.log
*.bak
*.tsbuildinfo
.DS_Store
.gstack/
.agents/
.claude/settings.local.json
